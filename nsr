#!/usr/bin/env python3
# nsr — DNS queries via DNS-over-HTTPS (DoH)
# Usage:
#   nsr rcdeiraq.com                 # default dns server: cloudflare
#   nsr rcdeiraq.com --dns google    # cloudflare|google|quad9|opendns
#   nsr rcdeiraq.com --types A,MX,TXT
#   nsr rcdeiraq.com --raw           # dump API JSON
#   nsr --help

import argparse
import json
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request

API_URL = "https://dns.google/resolve"
DNS_CHOICES = ["cloudflare", "google", "quad9", "opendns"]
TYPE_MAP = {"A": 1, "AAAA": 28, "MX": 15, "NS": 2, "TXT": 16, "CNAME": 5, "SOA": 6}
TYPE_NAMES = {"A": "A", "AAAA": "AAAA", "MX": "MX", "NS": "NS", "TXT": "TXT", "CNAME": "CNAME", "SOA": "SOA"}
RESOLVER_URLS = {
    "google": "https://dns.google/resolve",
    "cloudflare": "https://cloudflare-dns.com/dns-query",
    "quad9": "https://dns.quad9.net/dns-query",
    "opendns": "https://doh.opendns.com/dns-query",
}
USER_AGENT = "nsr/1.0 (+https://github.com/iq5sa/nsr-cli)"


def post_json(url, payload, timeout=15):
    params = urllib.parse.urlencode(payload)
    req = urllib.request.Request(
        f"{url}?{params}",
        headers={"Accept": "application/dns-json", "User-Agent": USER_AGENT},
    )
    ctx = ssl.create_default_context()
    with urllib.request.urlopen(req, context=ctx, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


def colfit(values, minw=4, maxw=60):
    values = [str(v) for v in values]
    if not values:
        return minw
    w = max(minw, min(max(len(v) for v in values), maxw))
    return w


def print_table(rows, headers):
    if not rows:
        print("  (no answers)")
        return
    cols = list(zip(*([headers] + rows)))
    widths = [colfit(col) for col in cols]
    fmt = "  " + "  ".join(f"{{:{w}}}" for w in widths)
    print(fmt.format(*headers))
    print(fmt.format(*["-" * w for w in widths]))
    for r in rows:
        print(fmt.format(*[("" if x is None else x) for x in r]))


def pick(v, *keys, default=None):
    for k in keys:
        if isinstance(v, dict) and k in v:
            v = v[k]
        else:
            return default
    return v


def normalize_answer(record_type, answer):
    name = answer.get("name") or ""
    ttl = answer.get("TTL")
    raw = answer.get("data") or ""

    if record_type in ("A", "AAAA"):
        return {"record": {"name": name, "ttl": ttl, "ip": raw, "target": raw}}
    if record_type == "MX":
        pieces = raw.split()
        if len(pieces) >= 2:
            priority, target = pieces[0], pieces[1]
        else:
            priority, target = None, raw
        return {"record": {"name": name, "ttl": ttl, "priority": priority, "target": target}}
    if record_type in ("NS", "CNAME"):
        return {"record": {"name": name, "ttl": ttl, "target": raw}}
    if record_type == "TXT":
        text = raw.strip()
        strings = [text] if text else []
        return {"record": {"name": name, "ttl": ttl, "strings": strings}}
    if record_type == "SOA":
        parts = raw.split()
        if len(parts) >= 7:
            host, admin, serial, refresh, retry, expire, minimum = parts[:7]
        else:
            host, admin, serial, refresh, retry, expire, minimum = (None, None, None, None, None, None, None)
        return {
            "record": {
                "name": name,
                "ttl": ttl,
                "host": host,
                "admin": admin,
                "serial": serial,
                "refresh": refresh,
                "retry": retry,
                "expire": expire,
                "minimum": minimum,
            }
        }
    return {"record": {"name": name, "ttl": ttl, "target": raw}}


def fetch_section(domain, dns_name, record_type, timeout=15):
    endpoint = RESOLVER_URLS.get(dns_name, API_URL)
    params = {"name": domain, "type": TYPE_NAMES.get(record_type, record_type)}
    try:
        data = post_json(endpoint, params, timeout=timeout)
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="ignore")
        return {
            "query": {"server": {"ip": dns_name}},
            "response": {"rCode": f"HTTP_{exc.code}", "answer": []},
            "error": body,
        }
    except Exception as exc:
        return {
            "query": {"server": {"ip": dns_name}},
            "response": {"rCode": f"ERROR", "answer": []},
            "error": str(exc),
        }

    answers = []
    for item in data.get("Answer", []):
        if item.get("type") != TYPE_MAP.get(record_type):
            continue
        answers.append(normalize_answer(record_type, item))

    rcode = "NOERROR" if data.get("Status") == 0 else f"RCODE_{data.get('Status')}"
    return {"query": {"server": {"ip": dns_name}}, "response": {"rCode": rcode, "answer": answers}}


def extract_rows(record_type, section):
    """Return list of ordered rows (lists/tuples) per record type."""
    answers = pick(section, "response", "answer", default=[]) or []
    rows = []
    for a in answers:
        rec = a.get("record", {})
        ttl = rec.get("ttl")
        name = rec.get("name")
        target = rec.get("target")
        ip_or_target = rec.get("ip") or target
        if record_type == "A":
            rows.append([name, ttl, ip_or_target])
        elif record_type == "AAAA":
            rows.append([name, ttl, ip_or_target])
        elif record_type == "MX":
            rows.append([name, ttl, rec.get("priority"), target])
        elif record_type == "NS":
            rows.append([name, ttl, target])
        elif record_type == "TXT":
            s = rec.get("strings") or []
            rows.append([name, ttl, " ".join(s)])
        elif record_type == "CNAME":
            rows.append([name, ttl, target])
        elif record_type == "SOA":
            rows.append([
                name,
                ttl,
                rec.get("host"),
                rec.get("admin"),
                rec.get("serial"),
                rec.get("refresh"),
                rec.get("retry"),
                rec.get("expire"),
                rec.get("minimum"),
            ])
    return rows


def print_section(rt, section):
    q = pick(section, "query", default={})
    resp = pick(section, "response", default={})
    rcode = resp.get("rCode")
    server_ip = pick(q, "server", "ip")
    header = f"[{rt}] rcode={rcode}" + (f" via {server_ip}" if server_ip else "")
    print(header)

    if rcode != "NOERROR":
        print(f"  (query failed: {rcode})")
        return

    rows = extract_rows(rt, section)
    if rt in ("A", "AAAA"):
        print_table(rows, ["Name", "TTL", "Address"])
    elif rt == "MX":
        print_table(rows, ["Name", "TTL", "Priority", "Target"])
    elif rt == "NS":
        print_table(rows, ["Name", "TTL", "Target"])
    elif rt == "TXT":
        print_table(rows, ["Name", "TTL", "Text"])
    elif rt == "CNAME":
        print_table(rows, ["Name", "TTL", "Target"])
    elif rt == "SOA":
        print_table(rows, ["Name", "TTL", "MNAME", "RNAME", "Serial", "Refresh", "Retry", "Expire", "MinTTL"])


def main():
    ap = argparse.ArgumentParser(description="Fetch DNS records using DNS-over-HTTPS and pretty-print them.")
    ap.add_argument("domain", nargs="?", help="Domain name (e.g., example.com)")
    ap.add_argument("--dns", default="cloudflare", choices=DNS_CHOICES, help="Resolver to query")
    ap.add_argument("--types", default="A,AAAA,MX,NS,TXT,SOA", help="Comma-separated list (e.g. A,MX,TXT)")
    ap.add_argument("--timeout", type=int, default=15, help="HTTP timeout seconds")
    ap.add_argument("--raw", action="store_true", help="Print raw JSON response")
    args = ap.parse_args()

    if not args.domain:
        ap.print_help(sys.stderr)
        sys.exit(2)

    dom = args.domain.strip().rstrip(".")
    want = [t.strip().upper() for t in args.types.split(",") if t.strip()]
    records = {}

    try:
        for rt in want:
            if rt not in TYPE_MAP:
                print(f"[{rt}] (unsupported record type)")
                continue
            records[rt.lower()] = fetch_section(dom, args.dns, rt, timeout=args.timeout)
    except Exception as exc:
        sys.stderr.write(f"Request failed: {exc}\n")
        sys.exit(1)

    if args.raw:
        print(json.dumps({"domain": dom, "dnsServer": args.dns, "records": records}, ensure_ascii=False, indent=2))
        return

    print(f"Domain: {dom}\nDNS Server: {args.dns}\n")
    for rt in want:
        if rt not in TYPE_MAP:
            continue
        section = records.get(rt.lower())
        if not section:
            print(f"[{rt}] (no section returned)\n")
            continue
        print_section(rt, section)
        print()


if __name__ == "__main__":
    main()
